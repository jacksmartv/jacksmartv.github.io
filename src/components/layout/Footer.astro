---
import { Link, GitFork, Mail, Newspaper } from '@lucide/astro';
import Container from '../ui/Container.astro';
import { profile } from '../../data/profile';

const lastUpdated = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<footer id="contact" class="border-t border-border py-16">
  <Container>
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-2xl font-semibold text-text-primary">Contact</h2>
        <p class="mt-2 max-w-sm text-text-secondary">
          Open to conversations about platform architecture, cloud strategy, and engineering leadership.
        </p>
        <div class="mt-6 flex flex-col gap-3">
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-text-secondary transition-colors duration-150 hover:text-accent"
          >
            <Link class="h-4 w-4" aria-hidden="true" />
            LinkedIn
          </a>
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-text-secondary transition-colors duration-150 hover:text-accent"
          >
            <GitFork class="h-4 w-4" aria-hidden="true" />
            GitHub
          </a>
          <a
            href={profile.medium}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-text-secondary transition-colors duration-150 hover:text-accent"
          >
            <Newspaper class="h-4 w-4" aria-hidden="true" />
            Medium
          </a>
          <a
            href={`mailto:${profile.email}`}
            class="flex items-center gap-2 text-sm text-text-secondary transition-colors duration-150 hover:text-accent"
          >
            <Mail class="h-4 w-4" aria-hidden="true" />
            {profile.email}
          </a>
        </div>
      </div>

      <div class="text-sm text-text-muted">
        <p>Built with Astro</p>
        <p>Hosted on GitHub Pages</p>
        <p>Last updated {lastUpdated}</p>
      </div>
    </div>

    <p class="mt-12 border-t border-border pt-6 text-xs text-text-muted">
      &copy; {new Date().getFullYear()} {profile.name}. {profile.location}.
    </p>
  </Container>
</footer>
