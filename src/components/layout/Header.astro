---
import { Menu } from '@lucide/astro';
import Container from '../ui/Container.astro';

const navItems = [
  { href: '/work', label: 'Work' },
  { href: '/architecture', label: 'Architecture' },
  { href: '/articles', label: 'Articles' },
  { href: '/principles', label: 'Principles' },
  { href: '/resume', label: 'Resume' },
];

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur">
  <Container class="flex h-16 items-center justify-between">
    <a href="/" class="font-display text-sm font-semibold text-text-primary">
      Marcelo Santamaria
    </a>
    <nav class="hidden items-center gap-8 md:flex">
      {
        navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'text-sm transition-colors duration-150',
                isActive ? 'text-accent' : 'text-text-secondary hover:text-text-primary',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <a
      href="#contact"
      class="hidden text-sm text-text-secondary transition-colors duration-150 hover:text-text-primary md:block"
    >
      Contact
    </a>
    <details class="relative md:hidden">
      <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-border text-text-secondary [&::-webkit-details-marker]:hidden">
        <Menu class="h-4 w-4" aria-hidden="true" />
        <span class="sr-only">Toggle navigation menu</span>
      </summary>
      <nav class="absolute right-0 top-12 flex w-48 flex-col gap-1 rounded-xl border border-border bg-panel p-3 shadow-lg shadow-black/30">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="rounded-md px-3 py-2 text-sm text-text-secondary transition-colors duration-150 hover:bg-card hover:text-text-primary"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="#contact"
          class="rounded-md px-3 py-2 text-sm text-text-secondary transition-colors duration-150 hover:bg-card hover:text-text-primary"
        >
          Contact
        </a>
      </nav>
    </details>
  </Container>
</header>
