---
import { ArrowRight, FileDown } from '@lucide/astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { withBase } from '../../lib/url';
import { profile, heroHighlights, platformSnapshot } from '../../data/profile';
---

<section class="py-10 sm:py-12">
  <Container class="grid gap-16 lg:grid-cols-[1.1fr_1fr] lg:items-start">
    <div>
      <p class="font-mono text-sm uppercase tracking-wider text-accent">{profile.title}</p>
      <h1 class="mt-4 text-5xl font-semibold leading-[1.05] text-text-primary sm:text-6xl lg:text-7xl">
        Designing platforms that scale.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-text-secondary">
        Building scalable cloud platforms, distributed systems, and the engineering practices that
        keep them reliable — {profile.location}.
      </p>

      <ul class="mt-8 flex flex-wrap gap-2">
        {
          heroHighlights.map((item) => (
            <li class="rounded-full border border-border bg-panel px-3 py-1.5 text-sm text-text-secondary">
              {item}
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <Button href="/resume">
          <FileDown class="h-4 w-4" aria-hidden="true" />
          Download Resume
        </Button>
        <Button href="/work" variant="secondary">
          View Work
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </Button>
        <a
          href={withBase('/about')}
          class="text-sm text-text-secondary transition-colors duration-150 hover:text-text-primary"
        >
          More about me →
        </a>
      </div>
    </div>

    <div class="rounded-2xl border border-border bg-panel p-2">
      <div class="rounded-xl border border-border bg-card p-6">
        <p class="mb-4 font-mono text-xs uppercase tracking-wider text-text-muted">
          Platform Snapshot
        </p>
        <dl class="space-y-4">
          {
            platformSnapshot.map((item) => (
              <div class="flex items-center justify-between border-b border-border pb-4 last:border-b-0 last:pb-0">
                <dt class="text-sm text-text-secondary">{item.label}</dt>
                <dd class="font-mono text-sm text-text-primary">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Container>
</section>
