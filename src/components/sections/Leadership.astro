---
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { technicalLeadership } from '../../data/profile';
---

<section class="py-8">
  <Container>
    <SectionTitle
      eyebrow="Technical Leadership"
      title="Beyond architecture"
      description="Leading platform teams and setting the standards they operate by."
    />

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        technicalLeadership.map((item) => (
          <div class="rounded-xl border border-border bg-card p-6">
            <h3 class="font-medium text-text-primary">{item.title}</h3>
            <p class="mt-2 text-sm text-text-secondary">{item.description}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
