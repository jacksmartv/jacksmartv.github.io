---
import { ArrowRight } from '@lucide/astro';
import Card from './Card.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
}

const { href, title, summary } = Astro.props;
---

<Card href={href}>
  <h3 class="text-xl font-semibold text-text-primary">{title}</h3>
  <p class="mt-3 text-text-secondary">{summary}</p>
  <p class="mt-6 flex items-center gap-1.5 text-sm font-medium text-accent">
    Read RFC
    <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
  </p>
</Card>
