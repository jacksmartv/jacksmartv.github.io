---
import Card from './Card.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  readingTime: string;
  category: string;
}

const { href, title, summary, date, readingTime, category } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Card href={href}>
  <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-wider text-text-muted">
    <span>{formattedDate}</span>
    <span aria-hidden="true">·</span>
    <span>{readingTime}</span>
    <span aria-hidden="true">·</span>
    <span class="text-accent">{category}</span>
  </div>
  <h3 class="mt-4 text-xl font-semibold text-text-primary">{title}</h3>
  <p class="mt-3 text-text-secondary">{summary}</p>
</Card>
