---
import { withBase } from '../../lib/url';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
const resolvedHref = href.startsWith('/') ? withBase(href) : href;

const base =
  'inline-flex items-center gap-2 rounded-lg px-5 py-3 text-sm font-medium transition-colors duration-150';
const variants = {
  primary: 'bg-accent text-white hover:bg-accent-hover',
  secondary:
    'border border-border bg-transparent text-text-primary hover:border-accent hover:text-accent',
};
---

<a href={resolvedHref} class:list={[base, variants[variant], className]}>
  <slot />
</a>
