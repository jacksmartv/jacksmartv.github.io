---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div
  class:list={[
    'rounded-xl border border-border bg-panel p-6',
    className,
  ]}
>
  <p class="mb-2 font-mono text-xs uppercase tracking-wider text-text-muted">{label}</p>
  <div class="text-text-primary">
    <slot />
  </div>
</div>
