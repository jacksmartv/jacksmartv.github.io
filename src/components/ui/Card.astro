---
import { withBase } from '../../lib/url';

interface Props {
  href?: string;
  class?: string;
  hoverable?: boolean;
}

const { href, class: className, hoverable = Boolean(href) } = Astro.props;
const Tag = href ? 'a' : 'div';
const resolvedHref = href?.startsWith('/') ? withBase(href) : href;

const base =
  'block rounded-2xl border border-border bg-card p-8 transition-all duration-150';
const hover = hoverable ? 'hover:border-accent/40 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/20' : '';
---

<Tag href={resolvedHref} class:list={[base, hover, className]}>
  <slot />
</Tag>
