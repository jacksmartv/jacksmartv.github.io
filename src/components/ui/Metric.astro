---
interface Props {
  label: string;
  value: string;
  class?: string;
}

const { label, value, class: className } = Astro.props;
---

<div class:list={['flex items-start justify-between gap-4 border-b border-border py-3 last:border-b-0', className]}>
  <span class="shrink-0 text-sm text-text-secondary">{label}</span>
  <span class="font-mono text-sm text-text-primary text-right">{value}</span>
</div>
