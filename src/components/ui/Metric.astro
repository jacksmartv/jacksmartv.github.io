---
interface Props {
  label: string;
  value: string;
  class?: string;
}

const { label, value, class: className } = Astro.props;
---

<div class:list={['flex items-center justify-between border-b border-border py-3 last:border-b-0', className]}>
  <span class="text-sm text-text-secondary">{label}</span>
  <span class="font-mono text-sm text-text-primary">{value}</span>
</div>
