---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className } = Astro.props;
---

<div class:list={['max-w-2xl', className]}>
  {
    eyebrow && (
      <p class="mb-3 font-mono text-sm uppercase tracking-wider text-accent">{eyebrow}</p>
    )
  }
  <h2 class="text-3xl font-semibold text-text-primary sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg text-text-secondary">{description}</p>}
</div>
