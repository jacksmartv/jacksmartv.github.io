---
import { ArrowRight } from '@lucide/astro';
import Card from './Card.astro';
import Tag from './Tag.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  stack: readonly string[];
}

const { href, title, summary, stack } = Astro.props;
---

<Card href={href}>
  <h3 class="text-xl font-semibold text-text-primary">{title}</h3>
  <p class="mt-3 text-text-secondary">{summary}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {stack.slice(0, 4).map((tech) => <Tag>{tech}</Tag>)}
  </div>
  <p class="mt-6 flex items-center gap-1.5 text-sm font-medium text-accent">
    Read more
    <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
  </p>
</Card>
