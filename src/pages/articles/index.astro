---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Articles"
  description="Technical writing on cloud architecture, IoT systems, and engineering leadership from 20 years in platform engineering."
>
  <Container class="py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionTitle
        eyebrow="Engineering Journal"
        title="Articles"
        description="Notes from real platform, cloud, and IoT work — not general commentary."
      />
      <a
        href="/articles/rss.xml"
        class="text-sm text-text-secondary transition-colors duration-150 hover:text-accent"
      >
        RSS Feed
      </a>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        articles.map((item) => (
          <ArticleCard
            href={`/articles/${item.id}`}
            title={item.data.title}
            summary={item.data.summary}
            date={item.data.date}
            readingTime={item.data.readingTime}
            category={item.data.category}
          />
        ))
      }
    </div>
  </Container>
</BaseLayout>
