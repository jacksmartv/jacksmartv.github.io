---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import WorkCard from '../../components/ui/WorkCard.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Selected Work"
  description="Case studies from 20 years of platform, cloud, and IoT architecture — problem, constraints, decision, result."
>
  <Container class="py-16">
    <SectionTitle
      eyebrow="Selected Work"
      title="Case studies"
      description="Each project documents the problem, the constraints that shaped the decision, and the measured result — not just the tech stack."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        work.map((item) => (
          <WorkCard
            href={`/work/${item.id}`}
            title={item.data.title}
            summary={item.data.summary}
            stack={item.data.stack}
          />
        ))
      }
    </div>
  </Container>
</BaseLayout>
